class Solution {
    static final long MOD = 1_000_000_007L;

    public int zigZagArrays(int n, int l, int r) {
        int m = r - l + 1;
        int sz = 2 * m;

        long[] base = new long[sz];

        // Length = 2 state
        for (int v = 0; v < m; v++) {
            base[v] = v;             // U[v]
            base[m + v] = m - 1 - v; // D[v]
        }

        long[][] T = new long[sz][sz];

        // U_new[v] = sum D[x], x < v
        for (int v = 0; v < m; v++) {
            for (int x = 0; x < v; x++) {
                T[v][m + x] = 1;
            }
        }

        // D_new[v] = sum U[x], x > v
        for (int v = 0; v < m; v++) {
            for (int x = v + 1; x < m; x++) {
                T[m + v][x] = 1;
            }
        }

        long[][] P = matPow(T, n - 2);

        long[] state = multiply(P, base);

        long ans = 0;
        for (long x : state) {
            ans = (ans + x) % MOD;
        }

        return (int) ans;
    }

    private long[] multiply(long[][] A, long[] v) {
        int n = A.length;
        long[] res = new long[n];

        for (int i = 0; i < n; i++) {
            long sum = 0;
            for (int j = 0; j < n; j++) {
                sum = (sum + A[i][j] * v[j]) % MOD;
            }
            res[i] = sum;
        }
        return res;
    }

    private long[][] matMul(long[][] A, long[][] B) {
        int n = A.length;
        long[][] C = new long[n][n];

        for (int i = 0; i < n; i++) {
            for (int k = 0; k < n; k++) {
                if (A[i][k] == 0) continue;

                long aik = A[i][k];

                for (int j = 0; j < n; j++) {
                    if (B[k][j] == 0) continue;

                    C[i][j] = (C[i][j] + aik * B[k][j]) % MOD;
                }
            }
        }
        return C;
    }

    private long[][] matPow(long[][] M, long exp) {
        int n = M.length;

        long[][] res = new long[n][n];
        for (int i = 0; i < n; i++) {
            res[i][i] = 1;
        }

        while (exp > 0) {
            if ((exp & 1) == 1) {
                res = matMul(res, M);
            }
            M = matMul(M, M);
            exp >>= 1;
        }

        return res;
    }
}
