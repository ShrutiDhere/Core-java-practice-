class Solution {
    public long sumAndMultiply(int n) {
        long x = 0;
        int sum = 0;

        if (n == 0) {
            return 0;
        }

        String str = String.valueOf(n);

        for (int i = 0; i < str.length(); i++) {
            int digit = str.charAt(i) - '0';

            if (digit != 0) {
                x = x * 10 + digit;
                sum += digit;
            }
        }

        return x * sum;
    }
}
